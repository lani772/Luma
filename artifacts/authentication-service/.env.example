# .env.example for LUMA Authentication Service

# General Environment settings
ENV=development
PORT=8081
GRPC_PORT=50051

# Database Configuration
DATABASE_URL=postgres://luma_auth_user:luma_secure_password@localhost:5432/luma_auth_db?sslmode=disable

# Redis Configuration (Optional; fallback to memory blacklist if empty)
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_ISSUER=luma-auth-service
JWT_ACCESS_TTL=15m
# 30 Days Refresh Token TTL
JWT_REFRESH_TTL=720h
JWT_ALGORITHM=EdDSA

# Asymmetric Key Pairs (Base64 encoded PEM keys)
# If empty, the server automatically generates transient runtime keypairs on startup.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# Email Settings
# MODE can be: OR, AND, MAGIC_LINK_ONLY, OTP_ONLY
EMAIL_VERIFICATION_MODE=OR
# PROVIDER can be: smtp, console, mock
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@luma.local
MAGIC_LINK_TTL=15m
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5

# Event Broker Settings
# EVENT_BROKER_TYPE can be: nats, kafka, rabbitmq, memory
EVENT_BROKER_TYPE=memory
NATS_URL=
KAFKA_URL=
RABBITMQ_URL=

# Google Sign-In Client ID (for verification)
GOOGLE_CLIENT_ID=

# Security Constraints
LOCKOUT_ATTEMPTS=5
LOCKOUT_DURATION=15m
RATE_LIMIT_LOGIN_RPM=5
RATE_LIMIT_OTP_RPM=5
RATE_LIMIT_PASSWORD_RPM=3
RATE_LIMIT_GENERAL_RPM=60
DEVICE_FINGERPRINT_SALT=luma-fingerprint-salt-secure-xyz
