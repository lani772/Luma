# Luma Cloud Backend API
# Backend API URL - Update based on your deployment
NEXT_PUBLIC_API_URL=http://localhost:8090/cloud

# WebSocket URL for real-time updates (optional)
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8090/ws

# Application Info
NEXT_PUBLIC_APP_NAME=LUMA Smart Home
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=false

# Third-party Services (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_ID=

# Development only
NODE_ENV=development
